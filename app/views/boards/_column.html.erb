<% lane_hidden = board.lane_hidden?(column[:key]) %>
<section class="column column--<%= column[:color] %> <%= 'column--hidden' if lane_hidden %>" data-column="<%= column[:key] %>">
  <header class="column__header">
    <h2 title="<%= column[:title] %>"><span class="column__dot"></span><span class="column__title"><%= column[:title] %></span></h2>
    <span class="column__header-right">
      <%= button_to toggle_hidden_board_path(board, lane: column[:key]), method: :patch,
            class: "icon-btn column__eye #{'column__eye--hidden' if lane_hidden}",
            title: (lane_hidden ? "Cards in this column are hidden from others. Click to reveal." : "Hide other people's cards in this column") do %>
        <%= lane_hidden ? "🙈" : "👁" %>
      <% end %>
      <span class="column__count" title="Cards in this column"><%= cards.size %></span>
    </span>
  </header>

  <div class="add-card" data-controller="add-card">
    <div class="add-card__row" id="add-card-trigger-<%= column[:key] %>" data-keep-state data-add-card-target="trigger">
      <button type="button" class="add-card__trigger" data-action="add-card#open">＋ Add a card</button>
      <% if column[:key] == :last_time && (sources = board.import_sources).any? %>
        <details class="menu import-menu" data-keep-state id="import-menu" data-controller="picker">
          <summary class="add-card__trigger add-card__import" title="Import action items from another board">⇣ Import</summary>
          <div class="menu__body import-menu__body">
            <%= turbo_frame_tag "import-picker-#{board.id}", src: import_board_path(board), loading: :lazy, data: { turbo_permanent: true } do %>
              <span class="menu__label">Loading…</span>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>
    <%= form_with url: board_cards_path(board), id: "new-card-#{column[:key]}", class: "new-card", html: { hidden: true }, data: { keep_state: true, preserve_edits: true, add_card_target: "form", action: "turbo:submit-end->add-card#submitted" } do |f| %>
      <%= f.hidden_field :lane, name: "card[lane]", id: nil, value: column[:key] %>
      <%= f.text_area :content, name: "card[content]", id: nil, rows: 2, class: "input new-card__input", placeholder: "Write a card… (Enter to save, Esc to close)", maxlength: 2000, required: true, data: { action: "keydown->add-card#keydown", add_card_target: "input" } %>
      <div class="new-card__actions">
        <button type="button" class="btn btn--ghost btn--sm" data-action="add-card#close">Cancel</button>
        <%= f.submit "Add card", class: "btn btn--primary btn--sm" %>
      </div>
    <% end %>
  </div>
  <div class="column__cards" data-board-target="list" data-column="<%= column[:key] %>" data-action="dragover->board#dragover drop->board#drop dragleave->board#dragleave">
    <% cards.each do |card| %>
      <%= render "cards/card", card: card, board: board, votes_left: votes_left %>
    <% end %>
  </div>

</section>
