<% content_for :title, "#{@board.name} · Team Retro" %>
<% content_for :body_class, "board-page" %>
<%= turbo_stream_from @board %>

<div class="board" data-controller="board" data-board-move-url-value="<%= move_card_path(":id") %>" data-board-merge-url-value="<%= merge_card_path(":id") %>" data-board-sortable-value="<%= @board.sort_by == "order" %>">
  <div class="board__header">
    <div class="board__title">
      <%= link_to "‹ Boards", boards_path, class: "btn btn--ghost btn--sm" %>
      <div class="inline-title" data-controller="inline-title">
        <h1 data-inline-title-target="view"><button type="button" class="inline-title__button" title="Click to rename the board" data-action="inline-title#edit"><%= @board.name %></button></h1>
        <%= form_with model: @board, class: "inline-title__form", html: { hidden: true }, data: { inline_title_target: "form", action: "turbo:submit-end->inline-title#saved" } do |f| %>
          <%= f.text_field :name, class: "input inline-title__input inline-title__input--board", required: true, maxlength: 120, "aria-label": "Board name", data: { inline_title_target: "input", action: "keydown->inline-title#keydown blur->inline-title#commit" } %>
        <% end %>
      </div>
    </div>

    <div class="board__tools">
      <div class="votes-left <%= 'votes-left--empty' if @votes_left.zero? %>" title="Votes you have left">
        👍 <strong><%= @votes_left %></strong> / <%= @board.max_votes %> votes left
      </div>

      <%= render "boards/timer", board: @board %>


      <%= form_with model: @board, class: "inline-form", data: { controller: "autosubmit" } do |f| %>
        <%= f.select :sort_by, [ [ "Sort: manual order", "order" ], [ "Sort: most votes", "votes" ], [ "Sort: by author", "author" ] ], {}, class: "input input--sm", data: { action: "change->autosubmit#submit" }, "aria-label": "Sort cards" %>
      <% end %>

      <details class="menu" data-keep-state id="board-menu">
        <summary class="btn btn--sm">⚙ Options</summary>
        <div class="menu__body">
          <%= form_with model: @board, data: { controller: "autosubmit" } do |f| %>
            <span class="menu__label">Hide cards from others in…</span>
            <%= f.hidden_field :hidden_lanes, multiple: true, value: "", id: nil %>
            <% @board.columns.each do |column| %>
              <label class="check"><%= f.check_box :hidden_lanes, { multiple: true, checked: @board.lane_hidden?(column[:key]), id: "board_hidden_lanes_#{column[:key]}", data: { action: "autosubmit#submit" } }, column[:key], nil %> <%= column[:title] %></label>
            <% end %>
            <hr>
            <% @board.all_columns.select { |column| @board.optional_column?(column) }.each do |column| %>
              <label class="check"><%= f.check_box column[:key], data: { action: "autosubmit#submit" } %> <%= column[:title] %> column</label>
            <% end %>
            <label class="check"><%= f.check_box :hide_votes, data: { action: "autosubmit#submit" } %> Hide vote counts</label>
            <label class="check">Max votes <%= f.number_field :max_votes, min: 0, max: 99, class: "input input--xs", data: { action: "change->autosubmit#submit" } %></label>
          <% end %>
          <hr>
          <%= button_to "↺ Reset all votes", reset_votes_board_path(@board), method: :delete, class: "menu__item", form: { data: { turbo_confirm: "Remove every vote on this board? Everyone gets their votes back." } } %>
          <%= link_to "✎ Rename board", edit_board_path(@board), class: "menu__item" %>
          <%= button_to "🗑️ Delete board", @board, method: :delete, class: "menu__item menu__item--danger", form: { data: { turbo_confirm: "Delete this board and all its cards?" } } %>
        </div>
      </details>
    </div>
  </div>

  <% if @board.any_lane_hidden? %>
    <p class="banner">🙈 Cards from other people are hidden in
      <strong><%= @board.columns.select { |c| @board.lane_hidden?(c[:key]) }.map { |c| c[:title] }.to_sentence %></strong>
      while everyone brainstorms. Use the eye button in a column header to reveal them.</p>
  <% end %>

  <div class="columns">
    <% @columns.each do |column, cards| %>
      <%= render "boards/column", board: @board, column: column, cards: cards, votes_left: @votes_left %>
    <% end %>
  </div>
</div>
