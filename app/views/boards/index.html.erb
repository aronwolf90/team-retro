<% content_for :title, "Boards · Team Retro" %>
<div class="page">
  <div class="page__header">
    <div>
      <h1>Retro boards</h1>
      <p class="muted">All of your team's past and current retrospectives.</p>
    </div>
    <%= link_to "＋ New board", new_board_path, class: "btn btn--primary" %>
  </div>

  <% if @boards.empty? %>
    <div class="empty">
      <p>No boards yet. Create the first one for your next sprint retro.</p>
      <%= link_to "Create a board", new_board_path, class: "btn btn--primary" %>
    </div>
  <% else %>
    <ul class="board-list">
      <% @boards.each do |board| %>
        <li class="board-item">
          <%= link_to board, class: "board-item__link" do %>
            <span class="board-item__name"><%= board.name %></span>
            <span class="board-item__meta">
              <%= pluralize(board.cards_count, "card") %> · created <%= board.created_at.strftime("%b %-d, %Y") %>
            </span>
            <% if board.context.present? %>
              <span class="board-item__context"><%= truncate(board.context, length: 140) %></span>
            <% end %>
          <% end %>
          <div class="board-item__actions">
            <%= button_to "Delete", board, method: :delete, class: "btn btn--danger btn--sm", form: { data: { turbo_confirm: "Delete “#{board.name}” and all its cards?" } } %>
          </div>
        </li>
      <% end %>
    </ul>
  <% end %>
</div>
