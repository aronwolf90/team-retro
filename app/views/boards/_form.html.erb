<%= form_with model: board, class: "stack" do |f| %>
  <% if board.errors.any? %>
    <div class="flash flash--alert"><%= board.errors.full_messages.to_sentence %></div>
  <% end %>
  <label class="field">
    <span>Board name</span>
    <%= f.text_field :name, class: "input", required: true, maxlength: 120, autofocus: true %>
  </label>
  <label class="field field--inline">
    <span>Max votes per person</span>
    <%= f.number_field :max_votes, class: "input input--sm", min: 0, max: 99 %>
  </label>
  <fieldset class="field">
    <legend>Columns</legend>
    <% Board::COLUMNS.each do |column| %>
      <% if board.optional_column?(column) %>
        <label class="check"><%= f.check_box column[:key] %> <%= column[:title] %> <span class="muted">(optional)</span></label>
      <% else %>
        <label class="check check--fixed"><input type="checkbox" checked disabled> <%= column[:title] %></label>
      <% end %>
    <% end %>
  </fieldset>
  <% if (sources = local_assigns[:import_sources]).present? %>
    <label class="field">
      <span>Import action items from</span>
      <%= select_tag :import_from_board_id, options_for_select([ [ "Don't import", "" ] ] + sources.map { |b| [ board_option_label(b), b.id ] }, local_assigns[:import_from_board_id]), class: "input" %>
      <span class="muted">Copies that board's action items into “From last retro”.</span>
    </label>
  <% end %>
  <fieldset class="field">
    <legend>Board options</legend>
    <span class="muted">Hide cards written by others (per column, reveal after brainstorming):</span>
    <%= f.hidden_field :hidden_lanes, multiple: true, value: "", id: nil %>
    <% Board::COLUMNS.each do |column| %>
      <label class="check"><%= f.check_box :hidden_lanes, { multiple: true, checked: board.lane_hidden?(column[:key]), id: "board_hidden_lanes_#{column[:key]}" }, column[:key], nil %> Hide <%= column[:title] %> cards</label>
    <% end %>
    <label class="check"><%= f.check_box :hide_votes %> Hide vote counts</label>
  </fieldset>
  <fieldset class="field">
    <legend>Board password</legend>
    <span class="muted">Only people with this password can open the board. The team password does not open it.</span>
    <div class="password-row" data-controller="password-generator">
      <%= f.password_field :password, class: "input", autocomplete: "new-password", placeholder: board.password_protected? ? "Leave empty to keep the current password" : "Optional", data: { password_generator_target: "input" } %>
      <button type="button" class="btn" data-action="password-generator#generate">Generate</button>
    </div>
    <% if board.password_protected? %>
      <label class="check"><%= f.check_box :remove_password %> Remove the password</label>
    <% end %>
  </fieldset>
  <div class="form-actions">
    <%= link_to "Cancel", board.persisted? ? board : boards_path, class: "btn btn--ghost" %>
    <%= f.submit board.persisted? ? "Save settings" : "Create board", class: "btn btn--primary" %>
  </div>
<% end %>
