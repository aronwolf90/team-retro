<div class="comment" id="<%= dom_id(comment) %>">
  <div class="comment__meta">
    <strong><%= comment.author_name.presence || "Someone" %></strong>
    <span class="muted"><%= time_ago_in_words(comment.created_at) %> ago</span>
    <%= button_to "×", comment, method: :delete, class: "linkish", title: "Delete comment" %>
  </div>
  <p class="comment__body"><%= comment.body %></p>
</div>
